{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://project-work-oi94.onrender.com/:path*"
    },
    {
      "source": "/docs",
      "destination": "https://project-work-oi94.onrender.com/docs"
    },
    {
      "source": "/redoc",
      "destination": "https://project-work-oi94.onrender.com/redoc"
    },
    {
      "source": "/openapi.json",
      "destination": "https://project-work-oi94.onrender.com/openapi.json"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
